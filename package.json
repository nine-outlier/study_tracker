{
  "name": "certification-tracker",
  "version": "1.1.0",
  "description": "Data Performance tool.",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/nine-outlier/study_tracker.git"
  },
  "scripts": {
    "build": "webpack --mode=development",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.7.3",
    "pdfjs-dist": "^5.4.449",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "autoprefixer": "^10.4.22",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.18",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  },
  "build": {
    "appId": "com.certification.tracker",
    "productName": "Study Tracker",
    "publish": [
      {
        "provider": "github",
        "owner": "nine-outlier",
        "repo": "study_tracker"
      }
    ],
    "files": [
      "dist/**/*",
      "index.html",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}